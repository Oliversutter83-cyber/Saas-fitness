# ---------------------------------------------------------------------------
# Copiez ce fichier en « .env » puis remplissez les valeurs.
# Le fichier .env ne doit JAMAIS être publié sur GitHub (il est déjà ignoré).
# ---------------------------------------------------------------------------

# Base de données PostgreSQL — OBLIGATOIRE, en local comme en production.
#
# Le plus simple : dans votre projet Vercel, onglet Storage → Create Database →
# Postgres. Vercel renseigne DATABASE_URL tout seul, vous n'avez rien à copier.
# Sinon, créez une base gratuite chez Neon ou Supabase et collez son URL ici.
#
# ⚠️ Prenez l'URL « pooled » (elle contient -pooler) si votre hébergeur en
# propose une : sur un hébergement sans serveur, chaque requête ouvre sa propre
# connexion, et une URL directe épuise vite le quota de connexions.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"

# Clé de signature des sessions de connexion — OBLIGATOIRE.
# Générez-en une avec :  openssl rand -base64 32
AUTH_SECRET=""

# Adresse publique du site (sert aux retours de paiement Stripe et au SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Votre adresse : elle seule aura accès à la page /app/kit-pub
OWNER_EMAIL=""

# ---------------------------------------------------------------------------
# Stripe — laissez vide pour travailler en « mode démo » (aucun paiement réel).
# ---------------------------------------------------------------------------

# Tableau de bord Stripe → Développeurs → Clés API
STRIPE_SECRET_KEY=""

# Stripe → Produits → créez un produit avec deux tarifs récurrents,
# puis copiez ici les identifiants qui commencent par « price_ ».
STRIPE_PRICE_MENSUEL=""
STRIPE_PRICE_ANNUEL=""

# Stripe → Développeurs → Webhooks → point de terminaison
# https://votre-domaine.fr/api/stripe/webhook
# Événements à écouter : checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""

# Bilan personnalisé (facultatif)
# Sans cette clé, le bilan fonctionne quand même : le programme, la semaine type
# et les objectifs sont calculés par le moteur du site. La clé n'ajoute que le
# commentaire personnalisé et la lecture de la photo.
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=""
