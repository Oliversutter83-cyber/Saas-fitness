# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Le modèle, lui, n'a que des valeurs d'exemple : il doit être versionné,
# c'est la liste de référence des variables à renseigner.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Prisma
/src/generated
/prisma/*.db
/prisma/*.db-journal

# Base SQLite locale
/dev.db
/dev.db-journal

# Fichiers de skills régénérés par les outils (Prisma, éditeurs)
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
